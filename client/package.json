{
  "name": "netptune",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:fr": "ng serve --configuration development-fr",
    "prebuild": "pnpm i18n:check",
    "build": "ng build",
    "build:en": "ng build --localize=en-GB",
    "docker:dev:build": "docker build --build-arg NG_CONFIGURATION=docker-dev -t netptune-client:dev -f Dockerfile .",
    "docker:dev:run": "docker run --rm --name netptune-client-dev --network=host -e NGINX_PORT=8080 -e API_URL=http://localhost:7400 netptune-client:dev",
    "docker:dev": "pnpm docker:dev:build && pnpm docker:dev:run",
    "i18n:extract": "ng extract-i18n",
    "i18n:check": "node scripts/check-catalogues.js",
    "lint": "ng lint",
    "update": "ng update",
    "prettier": "prettier --write \"src/**/*.{ts,html}\""
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@angular/aria": "^22.1.4",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/localize": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@lucide/angular": "^1.23.0",
    "@sindresorhus/slugify": "^3.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tiptap/core": "^3.31.0",
    "@tiptap/extension-bubble-menu": "^3.31.0",
    "@tiptap/extension-floating-menu": "^3.31.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-list": "^3.31.0",
    "@tiptap/extensions": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "apexcharts": "^7.1.0",
    "class-variance-authority": "^0.7.1",
    "codex-notifier": "^1.1.2",
    "codex-tooltip": "^1.0.6",
    "dayjs": "^1.11.23",
    "marked": "^18.0.11",
    "ng-apexcharts": "^3.1.0",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.2.0",
    "@angular-eslint/eslint-plugin": "22.2.0",
    "@angular-eslint/eslint-plugin-template": "22.2.0",
    "@angular-eslint/schematics": "^22.2.0",
    "@angular-eslint/template-parser": "22.2.0",
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@schematics/angular": "^22.1.6",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@typescript-eslint/utils": "^8.69.0",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "ng-extract-i18n-merge": "^3.4.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-classnames": "^0.10.4",
    "prettier-plugin-merge": "^0.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turnstile-types": "^1.2.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
