{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "netptune": {
      "projectType": "application",
      "i18n": {
        "sourceLocale": {
          "code": "en-GB",
          "subPath": ""
        },
        "locales": {
          "fr": {
            "translation": "src/locale/messages.fr.xlf"
          },
          "de": {
            "translation": "src/locale/messages.de.xlf"
          },
          "es": {
            "translation": "src/locale/messages.es.xlf"
          }
        }
      },
      "schematics": {
        "@schematics/angular:component": {
          "style": "css"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "allowedCommonJsDependencies": [
              "dayjs",
              "@editorjs/*"
            ],
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/assets",
              "src/assets/favicon.ico",
              "src/assets/favicon-16x16.png",
              "src/assets/favicon-32x32.png"
            ],
            "styles": [
              "src/styles.css"
            ],
            "polyfills": [
              "@angular/localize/init"
            ]
          },
          "configurations": {
            "production": {
              "localize": true,
              "i18nMissingTranslation": "error",
              "i18nDuplicateTranslation": "error",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "1.4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "docker-dev": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.container.ts"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "localize": true,
              "i18nMissingTranslation": "warning"
            },
            "development-fr": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "localize": [
                "fr"
              ],
              "i18nMissingTranslation": "warning"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 6400,
            "proxyConfig": "src/proxy.conf.json",
            "buildTarget": "netptune:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "netptune:build:production"
            },
            "development": {
              "buildTarget": "netptune:build:development"
            },
            "development-fr": {
              "buildTarget": "netptune:build:development-fr"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "ng-extract-i18n-merge:ng-extract-i18n-merge",
          "options": {
            "buildTarget": "netptune:build:development",
            "format": "xlf2",
            "outputPath": "src/locale",
            "sourceFile": "messages.xlf",
            "targetFiles": [
              "messages.fr.xlf",
              "messages.de.xlf",
              "messages.es.xlf"
            ],
            "trim": false,
            "collapseWhitespace": true,
            "fuzzyMatch": true,
            "includeContext": true,
            "newTranslationTargetsBlank": "omit"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:application": {
      "strict": true
    },
    "@schematics/angular:component": {
      "prefix": "app",
      "style": "none",
      "skipTests": true,
      "type": "component",
      "inlineTemplate": true
    },
    "@schematics/angular:class": {
      "skipTests": true
    },
    "@schematics/angular:directive": {
      "skipTests": true,
      "type": "directive"
    },
    "@schematics/angular:service": {
      "skipTests": true,
      "type": "service"
    },
    "@schematics/angular:pipe": {
      "skipTests": true,
      "typeSeparator": "."
    },
    "@schematics/angular:guard": {
      "skipTests": true,
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "skipTests": true,
      "typeSeparator": "."
    },
    "@angular-eslint/schematics:application": {
      "setParserOptionsProject": true
    },
    "@angular-eslint/schematics:library": {
      "setParserOptionsProject": true
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "packageManager": "pnpm",
    "analytics": false,
    "cache": {
      "enabled": true,
      "path": ".cache",
      "environment": "all"
    }
  }
}
