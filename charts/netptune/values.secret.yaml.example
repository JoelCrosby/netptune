# The shape of secrets.prod.enc.yaml in the private netptune-secrets repo once decrypted
# (`sops -d`), and of a plain values file for a manual `helm upgrade -f`. Each comment names the
# GitHub Actions secret the value used to come from, for the one-time migration.

ingress:
  tls:
    email: "" # TLS_EMAIL

secrets:
  postgres:
    postgres_password: "" # POSTGRES_PASSWORD
  cache:
    cache_password: "" # CACHE_PASSWORD
  meilisearch:
    master_key: "" # NETPTUNE_MEILISEARCH_MASTER_KEY
  aspire:
    # GitHub OAuth app with callback https://aspire.netptune.co.uk/oauth2/callback
    github_client_id: "" # ASPIRE_GITHUB_CLIENT_ID
    github_client_secret: "" # ASPIRE_GITHUB_CLIENT_SECRET
    # openssl rand -base64 32 | tr -- '+/' '-_'
    cookie_secret: "" # ASPIRE_COOKIE_SECRET
    # openssl rand -hex 32
    otlp_api_key: "" # ASPIRE_OTLP_API_KEY
  headlamp:
    github_client_id: "" # HEADLAMP_GITHUB_CLIENT_ID
    github_client_secret: "" # HEADLAMP_GITHUB_CLIENT_SECRET
    cookie_secret: "" # HEADLAMP_COOKIE_SECRET
  dbgate:
    github_client_id: "" # DBGATE_GITHUB_CLIENT_ID
    github_client_secret: "" # DBGATE_GITHUB_CLIENT_SECRET
    cookie_secret: "" # DBGATE_COOKIE_SECRET

# Shared by app, api, jobs and activity. Keys are .NET configuration keys in env form, so a new
# value needs only a line here and a property on the options class that reads it.
serverSecrets:
  Authentication__SigningKey: "" # SIGNING_KEY
  Authentication__GitHub__ClientSecret: "" # NETPTUNE_GITHUB_SECRET
  Authentication__Google__ClientSecret: "" # NETPTUNE_GOOGLE_SECRET
  Authentication__Microsoft__ClientSecret: "" # NETPTUNE_MICROSOFT_SECRET
  Storage__S3__BucketName: "" # S3_BUCKET_NAME
  Storage__S3__Region: "" # S3_REGION
  Storage__S3__AccessKeyId: "" # S3_ACCESS_KEY_ID
  Storage__S3__SecretAccessKey: "" # S3_SECRET_ACCESS_KEY
  Email__Cloudflare__ApiToken: "" # NETPTUNE_CLOUDFLARE_EMAIL_TOKEN
  Turnstile__SecretKey: "" # NETPTUNE_TURNSTILE_SECRET_KEY
  # Same value as the Cloudflare Transform Rule that stamps trustedProxies.edgeAuthorizationHeader.
  # Leave it out to skip the edge check; set it and the address header is only believed when it matches.
  TrustedProxies__EdgeAuthorizationSecret: "" # NETPTUNE_EDGE_AUTHORIZATION_SECRET

serverConfig:
  Authentication__GitHub__ClientId: "" # NETPTUNE_GITHUB_CLIENT_ID
  Authentication__GitHub__CallbackPath: "" # NETPTUNE_GITHUB_CALLBACK
  Authentication__Google__ClientId: "" # NETPTUNE_GOOGLE_CLIENT_ID
  Authentication__Google__CallbackPath: "" # NETPTUNE_GOOGLE_CALLBACK
  Authentication__Microsoft__ClientId: "" # NETPTUNE_MICROSOFT_CLIENT_ID
  Authentication__Microsoft__CallbackPath: "" # NETPTUNE_MICROSOFT_CALLBACK
  Email__Cloudflare__AccountId: "" # NETPTUNE_CLOUDFLARE_ACCOUNT_ID
